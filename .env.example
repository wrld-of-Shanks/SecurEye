# Specula Environment Variables

# MongoDB
MONGO_URI=mongodb://localhost:27017/specula

# Gateway
GATEWAY_PORT=3000
API_KEY=specula-dev-key-change-in-production
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info

# Network Service
NETWORK_SERVICE=http://localhost:5001
NETWORK_PORT=5001

# Code Service
CODE_SERVICE=http://localhost:5002
CODE_PORT=5002

# DAST Service
DAST_SERVICE=http://localhost:5003
DAST_PORT=5003

# Dashboard
REACT_APP_API_BASE=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000/ws

# Model Training (optional)
# MODEL_DIR=./models/weights
# DATA_DIR=./data
