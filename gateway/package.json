{
  "name": "specula-gateway",
  "version": "2.0.0",
  "description": "Specula API Gateway",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/__tests__"],
    "testMatch": ["**/*.test.js"],
    "moduleDirectories": ["node_modules", "<rootDir>/node_modules"],
    "moduleNameMapper": {
      "^\\.\\.\/shared\/(.*)$": "<rootDir>/../shared/$1"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "joi": "^18.2.3",
    "mongoose": "^7.8.11",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.1"
  }
}
