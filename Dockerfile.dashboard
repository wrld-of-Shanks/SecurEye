FROM node:20-alpine AS landing-build

WORKDIR /app

COPY frontend/landing/package*.json /app/
RUN npm install

COPY frontend/landing/ /app/
RUN npm run build

FROM node:20-alpine AS dashboard-build

WORKDIR /app

COPY frontend/dashboard/package*.json /app/
RUN npm install

COPY frontend/dashboard/ /app/
RUN npm run build

FROM nginx:alpine

COPY --from=landing-build /app/dist /usr/share/nginx/landing
COPY --from=dashboard-build /app/build /usr/share/nginx/dashboard
COPY frontend/dashboard/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3001

CMD ["nginx", "-g", "daemon off;"]
