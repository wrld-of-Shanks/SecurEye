FROM node:20-alpine AS build

WORKDIR /app

COPY dashboard/package*.json /app/
RUN npm install

COPY dashboard/ /app/
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY dashboard/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3001

CMD ["nginx", "-g", "daemon off;"]
